/// Calendar covering full years of Orders[Order Date]. Marked as date table.
table Date
	lineageTag: 42fbdce6-c0a6-42f1-bba3-25f1973adaf4
	dataCategory: Time

	column Date
		isUnique
		isKey
		formatString: dd-mmm-yyyy
		lineageTag: 94fe715d-8e9e-48e7-829a-40672394d835
		isNameInferred
		sourceColumn: [Date]

	column Year
		formatString: 0
		lineageTag: 938362db-d786-4fa6-9377-9f3f1d85edf2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

	column Quarter
		lineageTag: f7ee27d9-0d54-4822-be53-0fabffc96b9f
		isNameInferred
		sourceColumn: [Quarter]

	column 'Month No'
		isHidden
		lineageTag: 11f6ae43-3a00-46b4-8943-3cd6ace798fa
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month No]

	column Month
		lineageTag: 3469701c-e7c0-4450-8994-750e051085ee
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: 'Month No'

	column 'Month Year'
		lineageTag: c44aca3b-fc67-44ec-ace8-4fa84657adfa
		isNameInferred
		sourceColumn: [Month Year]
		sortByColumn: 'Month Year Sort'

	column 'Month Year Sort'
		isHidden
		lineageTag: 39434872-4112-4bde-a63e-5506073e2e54
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Year Sort]

	partition Date = calculated
		mode: import
		source =
				VAR _Start = DATE ( YEAR ( MIN ( Orders[Order Date] ) ), 1, 1 )
				VAR _End = DATE ( YEAR ( MAX ( Orders[Order Date] ) ), 12, 31 )
				RETURN
				    ADDCOLUMNS (
				        CALENDAR ( _Start, _End ),
				        "Year", YEAR ( [Date] ),
				        "Quarter", "Q" & QUARTER ( [Date] ),
				        "Month No", MONTH ( [Date] ),
				        "Month", FORMAT ( [Date], "MMM" ),
				        "Month Year", FORMAT ( [Date], "MMM yyyy" ),
				        "Month Year Sort", YEAR ( [Date] ) * 100 + MONTH ( [Date] )
				    )

