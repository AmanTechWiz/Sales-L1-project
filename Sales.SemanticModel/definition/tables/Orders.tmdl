/// One row per product line in a customer order (Superstore, 2021-2024).
table Orders
	lineageTag: b6c136a7-f4e9-4825-b8e1-d457f69889c5

	column 'Row ID'
		dataType: int64
		isHidden
		lineageTag: 79b8d3dd-0f7c-4ec6-bfcb-6fb9332cae54
		summarizeBy: none
		sourceColumn: Row ID

	column 'Order ID'
		dataType: string
		lineageTag: 95151127-b426-40bf-916c-ee9fe975266e
		sourceColumn: Order ID

	column 'Order Date'
		dataType: dateTime
		isHidden
		formatString: dd-mmm-yyyy
		lineageTag: 3d1b01cb-f8c5-4af6-99ec-499a853e0002
		sourceColumn: Order Date

	column 'Ship Date'
		dataType: dateTime
		formatString: dd-mmm-yyyy
		lineageTag: e51ef4e2-76d0-4726-95fc-f617aa1e30dc
		sourceColumn: Ship Date

	column 'Ship Mode'
		dataType: string
		lineageTag: 25f25027-93a3-41b7-824d-584f8de9f885
		sourceColumn: Ship Mode

	column 'Customer ID'
		dataType: string
		lineageTag: ef7c126d-28bb-4c67-a84b-8c2dca47cd5f
		sourceColumn: Customer ID

	column 'Customer Name'
		dataType: string
		lineageTag: ac1dff7f-8eb3-4ee0-9338-1c431ddce257
		sourceColumn: Customer Name

	column Segment
		dataType: string
		lineageTag: e19812fb-5f4f-468b-9e64-30d56952074e
		sourceColumn: Segment

	column Country/Region
		dataType: string
		lineageTag: cd698f0c-38c2-40ee-8526-98ba54afccc3
