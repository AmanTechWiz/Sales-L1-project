		sourceColumn: Country/Region

	column City
		dataType: string
		lineageTag: f3f5bc0e-da5a-4a89-9f17-a348702e5b2b
		dataCategory: City
		sourceColumn: City

	column State/Province
		dataType: string
		lineageTag: 20ead705-82f1-46d8-9168-d20f5e3de7bc
		dataCategory: StateOrProvince
		sourceColumn: State/Province

	column 'Postal Code'
		dataType: string
		lineageTag: 5d623f48-f089-4617-b754-7515e4df0545
		dataCategory: PostalCode
		sourceColumn: Postal Code

	column Region
		dataType: string
		lineageTag: 01755bff-ce52-472b-ac08-2a1b458c4c7f
		sourceColumn: Region

	column 'Product ID'
		dataType: string
		lineageTag: aba24c99-f349-4a63-aa27-2a80ab9b8208
		sourceColumn: Product ID

	column Category
		dataType: string
		lineageTag: 61879dcd-0241-44da-9071-bc9ab4b157f8
		sourceColumn: Category

	column Sub-Category
		dataType: string
		lineageTag: d00b8227-d17d-4760-8f2b-8b8dc9215601
		sourceColumn: Sub-Category

	column 'Product Name'
		dataType: string
		lineageTag: e85525f7-1c80-4188-9bd8-54474b92b60a
		sourceColumn: Product Name

	column Sales
		dataType: double
		isHidden
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: ae6bb1f0-ae3f-422b-97c1-79c0e15bf899
		summarizeBy: sum
		sourceColumn: Sales

	column Quantity
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 99ec3187-2b46-4db3-bdcd-e3c7a2258259
		summarizeBy: sum
		sourceColumn: Quantity

	column Discount
		dataType: double
		formatString: 0%
		lineageTag: 977c0389-9824-453c-a36b-1de01285938b
		summarizeBy: none
		sourceColumn: Discount

	column Profit
		dataType: double
		isHidden
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: aef12d02-06cf-48c0-a7d7-ccdb79418061
		summarizeBy: sum
		sourceColumn: Profit

	partition Orders = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("C:\Users\amande\OneDrive - Capgemini\Desktop\Sales\Sample - Superstore.xls"), null, true),
				    OrdersSheet = Source{[Name="Orders"]}[Data],
				    Promoted = Table.PromoteHeaders(OrdersSheet, [PromoteAllScalars=true]),
				    NonBlank = Table.SelectRows(Promoted, each [Row ID] <> null and [Row ID] <> ""),
				    Typed = Table.TransformColumnTypes(NonBlank, {
				        {"Row ID", Int64.Type}, {"Order ID", type text}, {"Order Date", type date}, {"Ship Date", type date},
				        {"Ship Mode", type text}, {"Customer ID", type text}, {"Customer Name", type text}, {"Segment", type text},
				        {"Country/Region", type text}, {"City", type text}, {"State/Province", type text}, {"Postal Code", type text},
				        {"Region", type text}, {"Product ID", type text}, {"Category", type text}, {"Sub-Category", type text},
				        {"Product Name", type text}, {"Sales", type number}, {"Quantity", Int64.Type}, {"Discount", type number}, {"Profit", type number}})
				in
				    Typed

